# ScoutAI Backend — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=scoutai

# Redis (for Celery broker — local dev only, not needed in production)
REDIS_URL=redis://localhost:6379/0

# Shared secret an external cron (e.g. cron-job.org) must send as the
# X-Cron-Secret header to trigger POST /api/cron/tick
CRON_SECRET=change-me-to-a-random-string

# Groq API Key (for LLM-powered features — chat onboarding and curation)
GROQ_API_KEY=gsk_...

# Tavily Search API Key (for web search)
TAVILY_API_KEY=tvly-...

# Resend API Key (for email delivery)
RESEND_API_KEY=re_...
FROM_EMAIL=ScoutAI <onboarding@resend.dev>

# JWT Secret (change this to a random string!)
JWT_SECRET=your-super-secret-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
